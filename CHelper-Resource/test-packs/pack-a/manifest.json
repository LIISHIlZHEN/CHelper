{
  // ===== 测试资源包 A：全功能演示 =====
  "name": "测试资源包 A",                 // 包显示名（管理页/来源标注用）
  "description": "导入测试包 v0.5：/welcome all（别名 /hi）、/grant、/execute myaction、/pentity（内置实体表）、/pitem（内置物品表+自定义物品）、/pblock（内置方块表+自定义方块）、/pgamemode、/pjson（JSON 结构）、选择器数据化（@x 变量 + myflag 布尔参数）；全文件带注释",
  "version": "0.5.0",                    // 展示版本
  "versionCode": 5,                      // 递增的整数版本号（覆盖更新依赖它）
  "versionType": "beta",                 // 面向版本类型（展示用）
  "branch": "thirdparty",                // 第三方拓展包惯例
  "author": "CHelper",
  "packId": "chelper-test-pack-a-0.1.0", // 全局唯一标识：换内容请递增 versionCode 并同步更新
  "isBasicPack": false,                  // 第三方包必须 false
  "priority": 100,                       // 预留字段：生效顺序 = 应用内资源包管理列表顺序（靠上优先）

  // ===== 合成指令：向内置 execute 追加 myaction 子命令 =====
  "extends": {
    "repeat": {
      "execute": {
        "mode": "append",                // 追加模式
        "file": "extensions/execute-addon.json"
      }
    }
  }
}
